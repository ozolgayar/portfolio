function initEducationCertsModal() {
  const paths = EDUCATION_CERT_IMAGES.filter(Boolean);
  const n = paths.length;
  let idx = 0;

  const overlay = document.getElementById('cert-overlay');
  const btnOpen = document.getElementById('btn-about-education');
  const imgEl = document.getElementById('cert-slide-img');
  const prevBtn = document.getElementById('cert-prev');
  const nextBtn = document.getElementById('cert-next');
  const counter = document.getElementById('cert-counter');
  const closeBtn = document.getElementById('cert-close');

  if (!overlay || !btnOpen || !imgEl || !prevBtn || !nextBtn || !counter || n === 0) {
    if (btnOpen && n === 0) btnOpen.style.display = 'none';
    return;
  }

  function show(i) {
    idx = ((i % n) + n) % n;
    imgEl.src = paths[idx];
    imgEl.alt = `Сертификат — слайд ${idx + 1} из ${n}`;
    counter.textContent = `${idx + 1} / ${n}`;
  }

  btnOpen.addEventListener('click', () => {
    show(0);
    overlay.classList.remove('hidden');
    closeBtn?.focus();
  });

  prevBtn.addEventListener('click', () => show(idx - 1));
  nextBtn.addEventListener('click', () => show(idx + 1));

  closeBtn?.addEventListener('click', closeModals);
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closeModals();
  });

  document.addEventListener('keydown', (e) => {
    if (overlay.classList.contains('hidden')) return;
    if (e.key === 'ArrowLeft') {
      e.preventDefault();
      show(idx - 1);
    } else if (e.key === 'ArrowRight') {
      e.preventDefault();
      show(idx + 1);
    }
  });
}

