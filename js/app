      <text class="core-node__label" ${coreNodeLabelAttrs(c)} fill="#f96c36" font-size="11">${c.circleLabel}</text>
    </g>`
  ).join('');

  function renderLines() {
    linesG.innerHTML = '';
    active.forEach((id) => {
      const c = COMPONENTS.find((x) => x.id === id);
      if (!c) return;
      const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      line.setAttribute('x1', String(c.cx));
      line.setAttribute('y1', String(c.cy));
      line.setAttribute('x2', String(CX));
      line.setAttribute('y2', String(CY));
      line.setAttribute('class', 'core-line');
      linesG.appendChild(line);
    });
  }

  function updateHud() {
    const n = active.length;
    let label = '[ STATUS: ' + n + '/4 ACTIVE • CORE: ';
    if (n === 0) label += 'STANDBY ]';
    else if (n < 4) label += 'INITIALIZING ]';
    else label += '● ONLINE ]';
    if (statusEl) statusEl.textContent = label;

    nodesG.querySelectorAll('.core-node').forEach((g) => {
      const id = g.getAttribute('data-core');
      g.classList.toggle('is-on', active.includes(id));
    });

    renderLines();

    const m = calcMetrics(active);
    if (metricsEl) {
      const metricLabels = ['Полнота', 'Вовлечённость', 'Качество'];
