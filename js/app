            .join(' ')}
        </div>
        <h4>${show.code} ${show.icon} ${show.title}</h4>
        <p class="mono">${show.subtitle}</p>
        <div class="about-bio">
          <p>${show.description}</p>
          <p class="mono">── ВКЛЮЧАЕТ ──</p>
          ${show.includes.map((x) => `<p> ▸ ${x}</p>`).join('')}
          <p class="mono">── ВЛИЯНИЕ НА КУРС ──</p>
          <p class="mono">Полнота +${show.weights.completeness}% · Вовлечённость +${show.weights.engagement}% · Качество +${show.weights.quality}%</p>
        </div>`;
      desc.querySelectorAll('.chip').forEach((btn) =>
        btn.addEventListener('click', () => {
          focusedId = btn.dataset.show;
          updateHud();
        })
      );
    }
  }

  nodesG.querySelectorAll('.core-node').forEach((g) => {
    g.addEventListener('click', () => {
      const id = g.getAttribute('data-core');
      if (active.includes(id)) {
        active = active.filter((x) => x !== id);
        lastOrder = lastOrder.filter((x) => x !== id);
        if (focusedId === id) focusedId = lastOrder[lastOrder.length - 1] ?? null;
      } else {
        active.push(id);
        lastOrder.push(id);
        focusedId = id;
      }
      updateHud();
    });
  });

  document.getElementById('core-reset')?.addEventListener('click', () => {
    active = [];
    lastOrder = [];
    focusedId = null;
    updateHud();
  });

  document.getElementById('core-activate-all')?.addEventListener('click', () => {
    active = [];
    lastOrder = [];
    focusedId = null;
    COMPONENTS.forEach((c, i) => {
      setTimeout(() => {
        if (!active.includes(c.id)) {
          active.push(c.id);
          lastOrder.push(c.id);
          focusedId = c.id;
        }
        updateHud();
      }, i * 220);
    });
  });

  updateHud();
}

/** Сравнение до/после — статичная сётка без слайдера */
function initCompare() {
  const wrap = document.getElementById('compare-static');
  if (!wrap) return;
  const beforeBars = wrap.querySelector('[data-compare-bars="before"]');
  const afterBars = wrap.querySelector('[data-compare-bars="after"]');
  if (!beforeBars || !afterBars) return;
  beforeBars.innerHTML = barBlock({ engagement: 10, completion: 20, retention: 10 }, false);
  afterBars.innerHTML = barBlock({ engagement: 90, completion: 85, retention: 75 }, true);

  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((ent) => {
        if (!ent.isIntersecting) return;
        afterBars.querySelectorAll('.metric-bar span').forEach((s) => {
          const pct = s.dataset.fill;
          if (pct) s.style.width = pct + '%';
        });
        io.disconnect();
      });
    },
    { threshold: 0.25 }
  );
  io.observe(wrap);
}

/** Визуальный слайдер «до / после» (перетаскивание границы) */
function initShowcaseBeforeAfter() {
  const viewport = document.getElementById('showcase-ba-viewport');
  const afterLayer = document.getElementById('showcase-after-layer');
  const handle = document.getElementById('showcase-ba-handle');
  if (!viewport || !afterLayer || !handle) return;

  let pct = 50;
  let draggingHandle = false;
  let draggingViewport = false;

  function revealFrost() {
    viewport.classList.add('is-ba-revealed');
  }

  function apply() {
    const p = Math.max(0, Math.min(100, pct));
    afterLayer.style.clipPath = `polygon(${p}% 0, 100% 0, 100% 100%, ${p}% 100%)`;
    handle.style.left = `${p}%`;
    handle.setAttribute('aria-valuenow', String(Math.round(p)));
  }

  function clientToPct(clientX) {
    const r = viewport.getBoundingClientRect();
    if (r.width <= 0) return pct;
    return Math.max(0, Math.min(100, ((clientX - r.left) / r.width) * 100));
  }

  function onMove(clientX) {
    pct = clientToPct(clientX);
    apply();
  }

  viewport.addEventListener('mousedown', (e) => {
    if (handle.contains(e.target)) return;
    draggingViewport = true;
    onMove(e.clientX);
  });

  handle.addEventListener('mousedown', (e) => {
    e.preventDefault();
    e.stopPropagation();
    draggingHandle = true;
    revealFrost();
  });

  window.addEventListener('mousemove', (e) => {
    if (draggingHandle) {
      onMove(e.clientX);
      return;
    }
    if (draggingViewport && e.buttons === 1) {
      revealFrost();
      onMove(e.clientX);
    }
  });

  window.addEventListener('mouseup', () => {
    draggingHandle = false;
    draggingViewport = false;
  });

  viewport.addEventListener(
    'touchstart',
    (e) => {
      const t = e.targetTouches[0];
      if (!t) return;
      if (handle.contains(e.target)) return;
      draggingViewport = true;
      onMove(t.clientX);
    },
    { passive: true }
  );

  handle.addEventListener(
    'touchstart',
    () => {
      draggingHandle = true;
      revealFrost();
    },
    { passive: true }
  );

  window.addEventListener(
    'touchmove',
    (e) => {
      if (!draggingHandle && !draggingViewport) return;
      revealFrost();
      const t = e.targetTouches[0];
      if (t) onMove(t.clientX);
    },
    { passive: true }
  );

  window.addEventListener('touchend', () => {
    draggingHandle = false;
    draggingViewport = false;
  });

  handle.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') {
      revealFrost();
      pct = Math.max(0, pct - 5);
      apply();
    } else if (e.key === 'ArrowRight') {
      revealFrost();
      pct = Math.min(100, pct + 5);
      apply();
    }
  });

  window.addEventListener('resize', apply);
  apply();
}

function barBlock(vals, animate) {
  const rows = [
    ['ВОВЛЕЧЁННОСТЬ', vals.engagement],
    ['ЗАВЕРШЕНИЕ', vals.completion],
    ['УДЕРЖАНИЕ', vals.retention],
  ];
  return rows
    .map(([lab, val]) => {
      const filled = animate ? `<span style="width:0%" data-fill="${val}"></span>` : `<span style="width:${val}%"></span>`;
      return `
      <div class="bar-row mono">${lab}</div>
      <div class="metric-row">
        <div class="metric-bar">${filled}</div>
        <span class="mono" style="min-width:2.5rem">${val}%</span>
      </div>
      <div class="bar-visual">${'▓'.repeat(Math.ceil(val / 10))}${'░'.repeat(10 - Math.ceil(val / 10))}</div>`;
    })
    .join('');
}

/** Появление панелей и fade-in элементов при скролле */
function initScrollReveal() {
  const panels = document.querySelectorAll('.panel');
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((en) => {
        en.target.classList.toggle('is-out', !en.isIntersecting);
        en.target.classList.toggle('is-in', en.isIntersecting);
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
  );
  panels.forEach((p) => io.observe(p));

  /** fade-ins */
  const fadels = document.querySelectorAll('.fade-in');
  const io2 = new IntersectionObserver(
    (entries, obs) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        en.target.classList.add('is-visible');
        obs.unobserve(en.target);
      });
    },
    { threshold: 0.05 }
  );
  fadels.forEach((el) => io2.observe(el));

  /** Волна появления карточек инструментов */
  const toolCells = document.querySelectorAll('#tools-grid .tool-cell');
  const io3 = new IntersectionObserver(
    (entries, obs) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        toolCells.forEach((cell, i) => {
          cell.style.opacity = '0';
          cell.style.transform = 'translateY(12px)';
          requestAnimationFrame(() => {
            setTimeout(() => {
              cell.style.transition = 'opacity 0.55s ease, transform 0.55s ease';
              cell.style.opacity = '1';
              cell.style.transform = 'translateY(0)';
            }, i * 50);
          });
        });
        obs.disconnect();
      });
    },
    { threshold: 0.08 }
  );
  if (toolCells.length) io3.observe(document.getElementById('toolkit'));
}

/** Герой — вход: теги/мета fade-in и «печать» заголовка */
function initHeroExtras() {
  const title = document.getElementById('hero-title');

  /** «Печать» заголовка: постепенная прозрачность строк уже видна через CSS animate — добавим класс ко входу */
  window.addEventListener('siteLoaded', () => {
    document.querySelectorAll('.section--hero .fade-in').forEach((el) => el.classList.add('is-visible'));

    if (!title) return;
    const lines = title.querySelectorAll('.hero__title-line');
    lines.forEach((ln, i) => {
      ln.style.opacity = '0';
      ln.style.transform = 'translateY(12px)';
      setTimeout(() => {
        ln.style.transition = 'opacity 0.8s cubic-bezier(.22,1,.36,1), transform 0.8s cubic-bezier(.22,1,.36,1)';
        ln.style.opacity = '1';
        ln.style.transform = 'translateY(0)';
      }, 120 + i * 180);
    });
    triggerGlitch(title.querySelector('.glitch-target'));
  });
}

/** Случайный лёгкий глитч */
function glitchLoop() {
  const targets = document.querySelectorAll('.glitch-target, .section-heading');
  setInterval(() => {
    if (!targets.length) return;
    const el = targets[Math.floor(Math.random() * targets.length)];
    triggerGlitch(el);
  }, 42000 + Math.random() * 20000);
}

function triggerGlitch(el) {
  if (!el) return;
  el.classList.remove('is-glitch');
  void el.offsetWidth;
  el.classList.add('is-glitch');
  setTimeout(() => el.classList.remove('is-glitch'), 380);
}

