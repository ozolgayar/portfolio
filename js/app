/** Метрики ядра */
function calcMetrics(ids) {
  const comps = COMPONENTS.filter((c) => ids.includes(c.id));
  return {
    completeness: comps.reduce((s, c) => s + c.weights.completeness, 0),
    engagement: comps.reduce((s, c) => s + c.weights.engagement, 0),
    quality: comps.reduce((s, c) => s + c.weights.quality, 0),
  };
}

function initCourseCore() {
  const svg = document.getElementById('core-svg');
  const nodesG = document.getElementById('core-nodes');
  const linesG = document.getElementById('core-lines');
  const desc = document.getElementById('core-desc');
  const statusEl = document.getElementById('core-status');
  const metricsEl = document.getElementById('core-metrics');
  const centerEl = document.getElementById('core-center');
  if (!svg || !nodesG || !linesG || !desc) return;

  const CX = 200;
  const CY = 200;
  let active = [];
  /** Порядок «последнего выбора» для чипов */
  let lastOrder = [];
  /** Какой активный компонент показать в левой колонке при нескольких выбранных */
  let focusedId = null;

  nodesG.innerHTML = COMPONENTS.map(
    (c) => `
    <g class="core-node" data-core="${c.id}" transform="translate(${c.cx},${c.cy})">
      <circle class="core-node__ring core-node__ring--hit" r="28"/>
