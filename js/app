/** Звёздное поле на canvas — редкое плавное мерцание */
function initStars(canvas) {
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  /** У режима «уменьшить анимации» тени статичные без моргания */
  let prefersReducedMotion = false;

  function mqReducedMotion() {
    prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  mqReducedMotion();

  /** @type { Array<{ x: number; y: number; r: number; phase: number; amp: number; freq: number; jitter: number; base: number }>} */
  let stars = [];
  let w = 0;
  let h = 0;

  window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', mqReducedMotion);

  function resize() {
    w = canvas.width = window.innerWidth;
    h = canvas.height = window.innerHeight;
    const count = Math.min(150, Math.floor((w * h) / 12000));
    stars = [];
    for (let i = 0; i < count; i++) {
      stars.push({
        x: Math.random() * w,
        y: Math.random() * h,
        r: 0.6 + Math.random() * 2.2,
        phase: Math.random() * Math.PI * 2,
        amp: 0.06 + Math.random() * 0.12,
        base: 0.28 + Math.random() * 0.35,
        freq: 0.003 + Math.random() * 0.008,
        jitter: Math.random() * Math.PI * 2,
      });
    }
  }



  function tick() {
    ctx.clearRect(0, 0, w, h);
    stars.forEach((s) => {
      let a;
      if (prefersReducedMotion) {
        a = s.base + s.amp * 0.5;
      } else {
        s.phase += s.freq;
        const shimmer =
          Math.sin(s.phase) * s.amp + Math.sin(s.phase * 1.12 + s.jitter) * (s.amp * 0.18);
        a = Math.min(1, Math.max(0.08, s.base + shimmer));
      }
      ctx.fillStyle = `rgba(232,230,224,${a.toFixed(4)})`;
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fill();
    });
    requestAnimationFrame(tick);
  }

  resize();
  window.addEventListener('resize', resize);
  requestAnimationFrame(tick);
}
/** Прелоадер: один раз за сессию (см. sessionStorage в index + класс preloader-skip) */
function runPreloader() {
  const el = document.getElementById('preloader');
  const fill = document.getElementById('preloader-fill');
  const pct = document.getElementById('preloader-pct');
  const ready = document.getElementById('preloader-ready');
  if (!el || !fill || !pct) return;

  const STORAGE_KEY = 'edufut_preloader_done';

  function finish(skipAnimate) {
    fill.style.width = '100%';
    pct.textContent = '100%';
    const bar = el.querySelector('.preloader__bar');
    if (bar) bar.setAttribute('aria-valuenow', '100');
    if (!skipAnimate) {
      ready?.classList.remove('hidden');
    }
    const delay = skipAnimate ? 0 : 350;
    setTimeout(() => {
      el.classList.add('is-done');
      el.setAttribute('aria-hidden', 'true');
      document.body.classList.add('is-loaded');
      try {
        sessionStorage.setItem(STORAGE_KEY, '1');
      } catch (e) {
        /* private mode */
      }
      window.dispatchEvent(new Event('siteLoaded'));
    }, delay);
  }

  let skip = false;
  try {
    skip = sessionStorage.getItem(STORAGE_KEY) === '1';
  } catch (e) {
    skip = false;
  }

  if (skip) {
    finish(true);
    return;
  }

  let p = 0;
  const goal = 100;
  const duration = 1800;
  const t0 = performance.now();

  function frame(now) {
    const t = Math.min(1, (now - t0) / duration);
    p = Math.round(t * goal);
    fill.style.width = p + '%';
    pct.textContent = p + '%';
    const bar = el.querySelector('.preloader__bar');
    if (bar) bar.setAttribute('aria-valuenow', String(p));
    if (t < 1) {
      requestAnimationFrame(frame);
    } else {
      finish(false);
    }
  }
  requestAnimationFrame(frame);
}

/** Кастомный курсор */
function initCursor() {
  const cur = document.getElementById('cursor');
  if (!cur) return;
  const isCoarse = window.matchMedia('(pointer: coarse)').matches;
  if (isCoarse) return;

  document.body.classList.add('has-custom-cursor');
  let mx = 0;
  let my = 0;
  let lx = 0;
  let ly = 0;

  document.addEventListener('mousemove', (e) => {
    mx = e.clientX;
    my = e.clientY;
    const target = e.target.closest('a, button, .format-card, .case-card, .faq-q, input, textarea');
    cur.classList.toggle('is-pointer', !!target);
  });

  cur.style.left = '0';
  cur.style.top = '0';

  function loop() {
    lx += (mx - lx) * 0.18;
    ly += (my - ly) * 0.18;
    cur.style.transform = `translate(${lx}px, ${ly}px) translate(-50%, -50%)`;
    requestAnimationFrame(loop);
  }
  loop();
}

